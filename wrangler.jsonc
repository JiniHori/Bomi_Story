{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bomistory",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/prep/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PREP_SYNC",
        "class_name": "PrepSyncStore"
      }
    ]
  },
  "exports": {
    "PrepSyncStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
